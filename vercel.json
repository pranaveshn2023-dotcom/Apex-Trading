{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**": {
      "maxDuration": 15,
      "includeFiles": "server/data/**"
    }
  },
  "rewrites": [
    { "source": "/api/market/quote/:symbol", "destination": "/api/market/quote?symbol=:symbol" },
    { "source": "/api/market/history/:symbol", "destination": "/api/market/history?symbol=:symbol" },
    { "source": "/api/portfolio", "destination": "/api/portfolio/index" },
    { "source": "/api/portfolio/update-funds", "destination": "/api/portfolio/funds" },
    { "source": "/api/positions/:id/close", "destination": "/api/positions/close?id=:id" },
    { "source": "/api/watchlists/add", "destination": "/api/watchlists" },
    { "source": "/api/watchlists/remove", "destination": "/api/watchlists" },
    { "source": "/api/journal/:id", "destination": "/api/journal" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, PATCH, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-user-id" }
      ]
    }
  ]
}
